{
  "name": "minecraft-builder-skill",
  "version": "0.2.0",
  "description": "Agent skill for designing high-quality Minecraft builds: a JavaScript building kit, vanilla structure/schematic export, headless renders and a builder's handbook.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "SKILL.md",
    "agents/",
    "scripts/",
    "assets/",
    "references/",
    "README.md",
    "LICENSE",
    "package.json",
    "npm-shrinkwrap.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattzh72/minecraft-builder-skill.git"
  },
  "bugs": {
    "url": "https://github.com/mattzh72/minecraft-builder-skill/issues"
  },
  "homepage": "https://github.com/mattzh72/minecraft-builder-skill#readme",
  "keywords": [
    "agent-skill",
    "litematica",
    "lodestone",
    "minecraft",
    "minecraft-building",
    "nbt",
    "procedural-generation",
    "schematic",
    "skills-cli",
    "worldedit"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node scripts/dev/kit-selftest.mjs",
    "build:example": "node scripts/run-build.mjs assets/examples/celestial-forge.mjs --out-dir minecraft-builds/celestial-forge",
    "render:example": "node scripts/render.mjs --nbt minecraft-builds/celestial-forge/celestial-forge.nbt",
    "preview:example": "node scripts/preview.mjs --nbt minecraft-builds/celestial-forge/celestial-forge.nbt",
    "data:block-colors": "node scripts/dev/gen-block-colors.mjs",
    "data:materials": "node scripts/dev/gen-materials.mjs",
    "docs:sync": "node scripts/sync-lodestone-docs.mjs --from ../lodestone",
    "docs:check": "node scripts/sync-lodestone-docs.mjs --from ../lodestone --check",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@mattzh72/lodestone": "0.6.0",
    "gl-matrix": "3.4.4",
    "three": "0.164.1",
    "vite": "8.0.16"
  }
}
