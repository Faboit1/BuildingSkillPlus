{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "bin/**/*.mjs",
    "scripts/**/*.mjs",
    "assets/viewer/src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "minecraft-builds"
  ]
}
